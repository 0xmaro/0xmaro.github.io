---
import Base from '../layouts/Base.astro';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import HomeExperience from '../components/identity/HomeExperience.astro';
import { getCollection } from 'astro:content';
import { caseNumbers, documentedTopics, featuredOnHome } from '../lib/content';
import { siteDescription } from '../config/site';
import { personSchema, websiteSchema } from '../lib/schema';
import { journeyTimeline } from '../lib/proof';

const lang = 'en';
const entries = await getCollection('writeups');
const featured = featuredOnHome(entries, lang);
const numbers = caseNumbers(entries);
const arsenal = await getCollection('arsenal');
const topics = documentedTopics(
  entries,
  arsenal.map((a) => a.data.domain[lang]),
  lang
);
const stations = await journeyTimeline();
---

<Base lang={lang} title="0xMARO — Ammar Mohammed Abdelrahman" description={siteDescription[lang]}>
  <Seo
    slot="head"
    lang={lang}
    path="/"
    title="0xMARO — Ammar Mohammed Abdelrahman"
    description={siteDescription[lang]}
  />
  <JsonLd slot="head" data={websiteSchema(lang, Astro.site!)} />
  <JsonLd slot="head" data={personSchema(topics)} />
  <HomeExperience lang={lang} featured={featured} numbers={numbers} stations={stations} />
</Base>
