---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { forSurface, livePaths, slugOf } from '../../lib/content';
import { journeyTimeline } from '../../lib/proof';
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';

/**
 * Capability table — shared by /arsenal and the home page §02.
 * Never an icon grid: domain, tools, and where they were actually used.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const arsenal = await getCollection('arsenal');
const writeups = await getCollection('writeups');
const projects = await getCollection('projects');
const notes = await getCollection('notes');
const journey = await journeyTimeline();

// Build a live target map across Writeups, Projects, Notes, Journey, and /security
// so every verified `usedOn` target becomes a real, working, labeled link.
const live = livePaths(writeups, projects, lang);
const enWriteups = new Map(
  forSurface(writeups, 'direct', 'en').map((e) => [`/writeups/${slugOf(e)}`, e])
);
const localWriteups = new Map(
  forSurface(writeups, 'direct', lang).map((e) => [`/writeups/${slugOf(e)}`, e])
);
const localProjects = new Map(
  forSurface(projects, 'direct', lang).map((e) => [`/projects/${slugOf(e)}`, e])
);
const localNotes = new Map(
  forSurface(notes, 'direct', lang).map((e) => [`/notes/${slugOf(e)}`, e])
);
const journeyMap = new Map(journey.map((s) => [`/journey/${s.id}`, s]));

function resolveUsedOn(usedOn: string): { href: string; label: string } | null {
  if (!usedOn) return null;
  if (usedOn === '/security') {
    return {
      href: getRelativeLocaleUrl(lang, '/security'),
      label: lang === 'ar' ? 'وضع الأمان المباشر (/security)' : 'Live Security Posture (/security)',
    };
  }
  const wLocal = localWriteups.get(usedOn);
  if (wLocal) return { href: getRelativeLocaleUrl(lang, usedOn), label: wLocal.data.title };
  const wEn = enWriteups.get(usedOn);
  if (wEn) return { href: usedOn, label: wEn.data.title };
  const p = localProjects.get(usedOn);
  if (p) return { href: getRelativeLocaleUrl(lang, usedOn), label: p.data.title };
  const n = localNotes.get(usedOn);
  if (n) return { href: getRelativeLocaleUrl(lang, usedOn), label: n.data.title };
  const j = journeyMap.get(usedOn);
  if (j) return { href: getRelativeLocaleUrl(lang, usedOn), label: j.data.event[lang] };
  if (live.has(usedOn)) return { href: getRelativeLocaleUrl(lang, usedOn), label: usedOn };
  return null;
}
---

{
  arsenal.length > 0 ? (
    <table class="arsenal">
      <thead>
        <tr>
          <th scope="col">{t('arsenal.domain')}</th>
          <th scope="col">{t('arsenal.tools')}</th>
          <th scope="col">{t('arsenal.usedOn')}</th>
        </tr>
      </thead>
      <tbody>
        {arsenal.map((d) => (
          <tr>
            <th scope="row" class="arsenal__domain">
              {d.data.domain[lang]}
            </th>
            <td class="arsenal__tools ltr">
              {d.data.rows.map((r) => r.tools.join(', ')).join(' · ')}
            </td>
            <td>
              <ul class="arsenal__used">
                {d.data.rows.map((r) => {
                  const target = resolveUsedOn(r.usedOn);
                  return (
                    <li>
                      {target ? (
                        <a href={target.href}>{target.label}</a>
                      ) : (
                        <span class="arsenal__none" aria-hidden="true">
                          —
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p class="arsenal__empty">{t('arsenal.empty')}</p>
  )
}

<style>
  .arsenal {
    width: 100%;
    margin-block-start: var(--space-6);
    border-collapse: collapse;
    border: var(--hairline) solid var(--line);
    font-size: var(--step--1);
  }

  .arsenal__empty {
    margin-block-start: var(--space-7);
    color: var(--text-lo);
    font-size: var(--step-1);
  }

  .arsenal th {
    text-align: start;
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
    font-weight: 400;
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    background: var(--ink-800);
  }

  html[lang='ar'] .arsenal th {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }

  .arsenal td {
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    color: var(--text);
    vertical-align: top;
  }

  .arsenal tbody tr:last-child td,
  .arsenal tbody tr:last-child th {
    border-block-end: none;
  }

  /* Row headers are <th> too: undo the column-label treatment above, which
     otherwise wins on specificity (.arsenal th beats .arsenal__domain). */
  .arsenal .arsenal__domain {
    font-family: inherit;
    font-size: inherit;
    text-transform: none;
    letter-spacing: normal;
    background: none;
    font-weight: 600;
    color: var(--text-hi);
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    text-align: start;
  }

  .arsenal__tools {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--text-lo);
    overflow-wrap: anywhere;
  }

  .arsenal__used {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .arsenal__used a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--sulfur-300);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
    font-family: var(--f-code);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .arsenal__used a:hover {
    color: var(--sulfur-400);
    border-block-end-color: var(--sulfur-400);
  }

  .arsenal__none {
    color: var(--text-dim);
  }
</style>
