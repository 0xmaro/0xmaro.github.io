---
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site, sectionPaths } from '../config/site';
import type { Language } from '../i18n/ui';
import { isRealProof } from '../lib/proof';
import { socialChannels, socialIcons } from '../data/social-icons';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const feedHref = lang === 'ar' ? '/rss-ar.xml' : '/rss.xml';
const profiles = socialChannels.filter((c) => isRealProof(c.url));
---

<footer>
  <div class="wrap foot">
    <span class="foot__brand ltr">{site.brand}</span>
    <a href={getRelativeLocaleUrl(lang, sectionPaths.security)}>{t('footer.posture')}</a>
    <a class="ltr" href="/.well-known/security.txt">{t('footer.security')}</a>
    <a class="ltr" href={feedHref}>{t('footer.rss')}</a>
    <ul class="foot__social" aria-label={t('footer.social')}>
      {
        profiles.map((p) => (
          <li>
            <a
              class="foot__icon"
              href={p.url}
              rel="me noopener noreferrer"
              target="_blank"
              aria-label={p.name}
              title={p.name}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={socialIcons[p.icon]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <span class="foot__end">{t('footer.note')}</span>
  </div>
</footer>

<style>
  footer {
    border-block-start: var(--hairline) solid var(--line);
    padding-block: var(--space-7) var(--space-8);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    align-items: center;
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .foot a {
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
    min-height: var(--touch-min);
    display: inline-flex;
    align-items: center;
  }

  .foot a:hover {
    color: var(--sulfur-400);
    border-block-end-color: var(--sulfur-400);
  }

  .foot__social {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot a.foot__icon {
    justify-content: center;
    min-inline-size: var(--touch-min);
    color: var(--text-lo);
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    transition:
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .foot a.foot__icon:hover,
  .foot a.foot__icon:focus-visible {
    color: var(--sulfur-400);
    border-color: var(--sulfur-400);
  }

  .foot__icon svg {
    inline-size: var(--social-glyph-sm);
    block-size: var(--social-glyph-sm);
    fill: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .foot a.foot__icon {
      transition: none;
    }
  }

  .foot__end {
    margin-inline-start: auto;
  }
</style>
