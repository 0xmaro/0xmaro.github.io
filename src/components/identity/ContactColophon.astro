---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Language } from '../../i18n/ui';
import { site, sectionPaths } from '../../config/site';
import { isRealProof } from '../../lib/proof';
import { socialIcons, type SocialIcon } from '../../data/social-icons';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const channels: { name: string; handle: string; url: string; icon: SocialIcon }[] = [
  { name: 'GitHub', handle: '@0xmaro', url: site.social.github, icon: 'github' },
  { name: 'LinkedIn', handle: 'amar-mohamed-0xmaro', url: site.social.linkedin, icon: 'linkedin' },
  { name: 'TryHackMe', handle: '0xmaro', url: site.social.tryhackme, icon: 'tryhackme' },
  { name: 'X', handle: '@0_xmaro', url: site.social.x, icon: 'x' },
  { name: 'YouTube', handle: '@0xmaro', url: site.social.youtube, icon: 'youtube' },
  { name: 'Instagram', handle: '@its_0xmaro', url: site.social.instagram, icon: 'instagram' },
  { name: 'Facebook', handle: '/0xmaro', url: site.social.facebook, icon: 'facebook' },
].filter((c) => isRealProof(c.url));

const copy = {
  en: {
    eyebrow: 'TRANSMISSION & PRESENCE',
    title: 'Want to build, break, or collaborate?',
    lead: 'Every profile below is verified and active. For security disclosures on this site itself, use the RFC 9116 contact in /.well-known/security.txt.',
    discordLabel: 'Discord handle',
    copyBtn: 'Copy',
    copiedBtn: 'Copied ✓',
    postureBtn: 'Inspect site security posture',
    disclosureBtn: '/.well-known/security.txt',
  },
  ar: {
    eyebrow: 'التواصل والحضور الرقمي',
    title: 'تريد أن نبني أو نحلّل أو نتعاون معاً؟',
    lead: 'كل الحسابات أدناه موثّقة ونشطة. وللإبلاغ عن أي ثغرة في هذا الموقع نفسه، استخدم بيانات التواصل في /.well-known/security.txt.',
    discordLabel: 'حساب Discord',
    copyBtn: 'نسخ',
    copiedBtn: 'تم النسخ ✓',
    postureBtn: 'استعرض الوضع الأمني للموقع',
    disclosureBtn: '/.well-known/security.txt',
  },
}[lang];
---

<div class="colophon">
  <div class="colophon__intro">
    <span class="colophon__eyebrow">{copy.eyebrow}</span>
    <h2 class="colophon__title">{copy.title}</h2>
    <p class="colophon__lead">{copy.lead}</p>
    <div class="colophon__meta-actions">
      <a class="btn" href={getRelativeLocaleUrl(lang, sectionPaths.security)}>
        {copy.postureBtn}
      </a>
      <a class="btn btn--ghost ltr" href="/.well-known/security.txt">
        {copy.disclosureBtn}
      </a>
    </div>
  </div>

  <div class="colophon__grid">
    {
      channels.map((ch) => (
        <a class="channel" href={ch.url} rel="me noopener noreferrer" target="_blank">
          <span class="channel__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d={socialIcons[ch.icon]} />
            </svg>
          </span>
          <span class="channel__text">
            <span class="channel__name">{ch.name}</span>
            <span class="channel__handle ltr">{ch.handle}</span>
          </span>
          <span class="channel__go ltr" aria-hidden="true">
            ↗
          </span>
        </a>
      ))
    }

    <div class="channel channel--copy">
      <span class="channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d={socialIcons.discord}></path>
        </svg>
      </span>
      <span class="channel__text">
        <span class="channel__name">{copy.discordLabel}</span>
        <span class="channel__handle ltr">{site.handles.discord}</span>
      </span>
      <button
        type="button"
        class="channel__copy-btn"
        data-copy-handle={site.handles.discord}
        data-copied-label={copy.copiedBtn}
        aria-label={`${copy.copyBtn} ${copy.discordLabel}: ${site.handles.discord}`}
      >
        {copy.copyBtn}
      </button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-handle]').forEach((btn) => {
    const original = btn.textContent ?? 'Copy';
    const copyText = async (value: string) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return true;
      }
      const ta = document.createElement('textarea');
      ta.value = value;
      ta.setAttribute('readonly', '');
      ta.className = 'sr-copy';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    };

    btn.addEventListener('click', async () => {
      const value = btn.dataset.copyHandle ?? '';
      try {
        await copyText(value);
        btn.textContent = btn.dataset.copiedLabel ?? 'Copied ✓';
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1800);
      } catch {
        // Fallback: clipboard unavailable in restricted context
      }
    });
  });
</script>

<style>
  .colophon {
    background: var(--plate-bg);
    border: var(--hairline) solid var(--plate-border);
    padding: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .colophon {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  .colophon__intro {
    display: grid;
    gap: var(--space-3);
  }

  .colophon__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--sulfur-400);
    letter-spacing: var(--ls-label);
  }

  .colophon__title {
    margin: 0;
    font-size: var(--step-2);
    color: var(--text-hi);
  }

  .colophon__lead {
    margin: 0;
    color: var(--text-lo);
    font-size: var(--step--1);
    max-width: 48ch;
  }

  .colophon__meta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  .btn--ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--text-lo);
  }

  .colophon__grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
  }

  .channel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--channel-min);
    padding: var(--space-3);
    background: var(--ink-800);
    border: var(--hairline) solid var(--line);
    text-decoration: none;
    transition: border-color var(--t-fast) ease;
  }

  .channel:hover,
  .channel:focus-visible {
    border-color: var(--sulfur-400);
  }

  .channel__icon {
    display: grid;
    place-items: center;
    inline-size: var(--social-badge);
    block-size: var(--social-badge);
    color: var(--blue-400);
    background: var(--ink-900);
    border: var(--hairline) solid var(--ink-600);
    border-radius: var(--radius);
    transition:
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .channel__icon svg {
    inline-size: var(--social-glyph);
    block-size: var(--social-glyph);
    fill: currentColor;
  }

  .channel:hover .channel__icon,
  .channel:focus-visible .channel__icon {
    color: var(--sulfur-400);
    border-color: var(--sulfur-400);
  }

  .channel__text {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .channel__go {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .channel:hover .channel__go {
    color: var(--sulfur-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .channel,
    .channel__icon {
      transition: none;
    }
  }

  .channel__name {
    display: block;
    font-family: var(--f-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-hi);
  }

  .channel__handle {
    display: block;
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--sulfur-300);
    justify-self: start;
    max-inline-size: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .channel--copy {
    border-style: dashed;
  }

  .channel__copy-btn {
    min-height: var(--touch-min);
    min-width: var(--touch-min);
    padding-inline: var(--space-3);
    background: var(--plate-bg);
    border: var(--hairline) solid var(--plate-border);
    color: var(--text-hi);
    font-family: var(--f-code);
    font-size: var(--text-2xs);
    cursor: pointer;
  }

  .channel__copy-btn:hover {
    border-color: var(--sulfur-400);
    color: var(--sulfur-300);
  }

  html[lang='ar'] .colophon__eyebrow,
  html[lang='ar'] .channel__name,
  html[lang='ar'] .channel__copy-btn {
    font-family: var(--f-body-ar);
  }
</style>
