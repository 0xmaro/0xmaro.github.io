---
import Base from './Base.astro';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Stamp from '../components/writeup/Stamp.astro';
import Callout from '../components/writeup/Callout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { useTranslations } from '../i18n/utils';
import {
  projectSlugOf,
  relatedNoteEntries,
  slugOf,
  type Project,
  type Writeup,
} from '../lib/content';
import { ogImagePath } from '../lib/og';
import { isTodo, journeyTimeline, surfaceProjectMetrics } from '../lib/proof';
import { breadcrumbSchema } from '../lib/schema';
import type { Language, UIKey } from '../i18n/ui';
import '../styles/prose.css';

interface Props {
  entry: Project;
  /** Counterpart project in the other language, when one exists. */
  translation?: Project;
  /** Related writeups already resolved to entries that build in production. */
  relatedWriteups: Writeup[];
}

const { entry, translation, relatedWriteups } = Astro.props;
const data = entry.data;
const lang: Language = data.lang;
const t = useTranslations(lang);
const other: Language = lang === 'en' ? 'ar' : 'en';
const slug = projectSlugOf(entry);
const path = `/projects/${slug}`;
const { Content, headings } = await render(entry);

const toc: MarkdownHeading[] = headings.filter((h) => h.depth === 2);
const images = data.media.filter((m) => m.type === 'image');

// Connected Knowledge Graph — resolve related notes & verified journey dossiers
const allNotes = await getCollection('notes');
const relatedNotes = relatedNoteEntries(allNotes, data.relatedNotes, lang);
const allJourney = await journeyTimeline();
const relatedJourney = data.relatedJourney
  .map((id) => allJourney.find((s) => s.id === id))
  .filter((s): s is (typeof allJourney)[number] => Boolean(s));

const hasConnected =
  relatedWriteups.length > 0 || relatedNotes.length > 0 || relatedJourney.length > 0;

const kindLabels: Record<NonNullable<typeof data.kind>, Record<Language, string>> = {
  hardware: { en: 'HARDWARE · EMBEDDED', ar: 'هاردوير · أنظمة مدمجة' },
  'digital-logic': { en: 'PURE DIGITAL LOGIC', ar: 'منطق رقمي صرف' },
  'security-web': { en: 'SECURITY-AUDITED WEB', ar: 'ويب مدقّق أمنياً' },
  fullstack: { en: 'FULL-STACK SYSTEM', ar: 'نظام Full-Stack' },
  'embedded-research': { en: 'EMBEDDED RESEARCH', ar: 'بحث أنظمة مدمجة' },
};

const graphCopy = {
  en: {
    toc: 'Dossier sections',
    gallery: 'Verified artifacts & visual evidence',
    connected: 'Connected knowledge graph',
    writeups: 'Security case files',
    notes: 'Engineering notes',
    journey: 'Verified journey milestones',
  },
  ar: {
    toc: 'أقسام الدراسة',
    gallery: 'الصور والمخططات الموثّقة',
    connected: 'المعرفة المرتبطة في الأرشيف',
    writeups: 'ملفات القضايا الأمنية',
    notes: 'الملاحظات الهندسية',
    journey: 'محطات المسار الموثّقة',
  },
}[lang];

const statusVariant = { live: 'ok', archived: 'med', private: 'blue' } as const;

// F-11: only metrics carrying a real http(s) proof URL are rendered.
const { shown: metrics, suppressed } = surfaceProjectMetrics(data.metrics);
for (const s of suppressed) {
  console.warn(`[proof] project "${slug}" metric "${s.claim}" held back — no real proof URL.`);
}

// Scaffolding placeholders are real data but never content.
const summary = isTodo(data.summary) ? null : data.summary;
const role = isTodo(data.role) ? null : data.role;
const securityNotes = isTodo(data.securityNotes) ? null : data.securityNotes;
const description = summary ?? t('projects.desc');

const noindex = data.visibility.noindex || data.visibility.unlisted;
const alternates = translation ? { [other]: path } : {};

// Same visibility contract as Writeup.astro (plan/04 F-01, plan/08 §8.6):
// an unlisted project or one hidden from search must not enter the Pagefind
// index. Removing `data-pagefind-body` is the mechanism — `data-pagefind-ignore`
// is element-scoped and cannot exclude a whole page.
const isUnlisted = data.visibility.unlisted;
const hideFromSearch = data.visibility.hideFrom.includes('search');
const pagefindIgnore = isUnlisted || hideFromSearch;

// `getRelativeLocaleUrl()` appends a trailing slash even to file routes
// ('...slug.png/'), which 404s on GitHub Pages — strip it for the OG route.
const ogUrl = getRelativeLocaleUrl(lang, ogImagePath('projects', slug)).replace(/\/+$/, '');

const mdxComponents = { Callout };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  headline: data.title,
  description: data.summary,
  inLanguage: lang,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: '0xMARO' },
  mainEntityOfPage: new URL(getRelativeLocaleUrl(lang, path), Astro.site!).href,
};

const breadcrumb = breadcrumbSchema(lang, Astro.site!, [
  { name: t('breadcrumb.home'), path: '/' },
  { name: t('projects.title'), path: '/projects' },
  { name: data.title, path },
]);
---

<Base
  lang={lang}
  title={`${data.title} — 0xMARO`}
  description={description}
  langFallback={translation ? undefined : '/projects'}
>
  <Seo
    slot="head"
    lang={lang}
    path={path}
    alternates={alternates}
    robots={noindex ? 'noindex' : 'index'}
    title={`${data.title} — 0xMARO`}
    description={description}
    image={ogUrl}
    imageAlt={data.title}
  />
  <JsonLd slot="head" data={jsonLd} />
  <JsonLd slot="head" data={breadcrumb} />

  <article class="project" data-project-root>
    <header class="wrap project__head">
      <p class="project__eyebrow">
        <bdi class="ltr">{t('projects.eyebrow')} · {slug}</bdi>
        {data.kind && <span class="project__kind"> · {kindLabels[data.kind][lang]}</span>}
      </p>
      <h1 class="project__title" data-pagefind-meta="title">{data.title}</h1>
      {summary && <p class="project__summary">{summary}</p>}

      <div class="project__meta">
        <div class="project__stamps">
          <Stamp variant={statusVariant[data.status]} label={t(`status.${data.status}` as UIKey)} />
        </div>

        <dl class="project__facts">
          {
            role && (
              <div class="fact">
                <dt>{t('project.role')}</dt>
                <dd>{role}</dd>
              </div>
            )
          }
          {
            data.stack.length > 0 && (
              <div class="fact">
                <dt>{t('project.stack')}</dt>
                <dd class="ltr">{data.stack.join(', ')}</dd>
              </div>
            )
          }
          {
            data.repo && (
              <div class="fact">
                <dt>{t('project.repo')}</dt>
                <dd class="ltr">
                  <a href={data.repo} rel="nofollow noreferrer">
                    {data.repo}
                  </a>
                </dd>
              </div>
            )
          }
          {
            data.demo && (
              <div class="fact">
                <dt>{t('project.demo')}</dt>
                <dd class="ltr">
                  <a href={data.demo} rel="nofollow noreferrer">
                    {data.demo}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    {
      metrics.length > 0 && (
        <div class="wrap project__metrics-wrap" aria-label={t('project.metrics')}>
          <div class="project__metrics">
            {metrics.map((m) => (
              <a class="metric" href={m.proof} rel="nofollow noreferrer">
                <span class="metric__value ltr">{m.value}</span>
                <span class="metric__label">{m.label}</span>
                <span class="metric__verify ltr">{t('proof.verify')}</span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      images.length > 0 && (
        <section class="wrap project__gallery" aria-label={graphCopy.gallery}>
          <h2 class="u-label project__sec-label">{graphCopy.gallery}</h2>
          <div class="pgallery">
            {images.map((m) => (
              <figure class="pfig">
                <button
                  type="button"
                  class="pfig__btn"
                  data-proj-lightbox-src={m.src}
                  data-proj-lightbox-alt={m.alt[lang]}
                  data-proj-lightbox-caption={m.caption?.[lang] ?? m.alt[lang]}
                  aria-label={t('journey.media.zoom').replace('{0}', m.alt[lang])}
                >
                  <img
                    class="pfig__img"
                    src={m.src}
                    alt={m.alt[lang]}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
                {m.caption && <figcaption class="pfig__cap">{m.caption[lang]}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div class="wrap project__grid">
      {
        toc.length > 0 && (
          <aside class="project__toc" aria-label={graphCopy.toc}>
            <p class="project__toc-label u-label">{graphCopy.toc}</p>
            <ol class="project__toc-list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <div class="project__content prose" data-pagefind-body={pagefindIgnore ? undefined : ''}>
        <Content components={mdxComponents} />
      </div>
    </div>

    {
      securityNotes && (
        <div class="wrap project__notes">
          <h2>{t('project.securityNotes')}</h2>
          <p>{securityNotes}</p>
        </div>
      )
    }

    {
      hasConnected && (
        <aside class="wrap project__related" aria-labelledby="proj-connected-title">
          <h2 id="proj-connected-title" class="u-label project__sec-label">
            {graphCopy.connected}
          </h2>
          <div class="pgraph">
            {relatedWriteups.length > 0 && (
              <div class="pgraph__col">
                <h3 class="pgraph__head">{graphCopy.writeups}</h3>
                <ul class="project__related-list">
                  {relatedWriteups.map((w) => (
                    <li>
                      <a href={getRelativeLocaleUrl(w.data.lang, `/writeups/${slugOf(w)}`)}>
                        {w.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {relatedNotes.length > 0 && (
              <div class="pgraph__col">
                <h3 class="pgraph__head">{graphCopy.notes}</h3>
                <ul class="project__related-list">
                  {relatedNotes.map((n) => (
                    <li>
                      <a href={getRelativeLocaleUrl(n.data.lang, `/notes/${slugOf(n)}`)}>
                        {n.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {relatedJourney.length > 0 && (
              <div class="pgraph__col">
                <h3 class="pgraph__head">{graphCopy.journey}</h3>
                <ul class="project__related-list">
                  {relatedJourney.map((s) => (
                    <li>
                      <a href={getRelativeLocaleUrl(lang, `/journey/${s.id}`)}>
                        {s.data.event[lang]}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      )
    }

    <dialog class="pbox" id="project-lightbox" aria-label={t('journey.lightbox.label')}>
      <div class="pbox__bar">
        <p class="pbox__cap" id="pbox-cap"></p>
        <button type="button" class="pbox__close" id="pbox-close">
          {t('journey.lightbox.close')}
        </button>
      </div>
      <img class="pbox__img" id="pbox-img" alt="" />
    </dialog>

    <footer class="wrap project__foot">
      {
        translation && (
          <a class="project__translate" href={getRelativeLocaleUrl(other, path)}>
            {lang === 'en' ? t('project.readInAr') : t('project.readInEn')}
          </a>
        )
      }
      <a class="project__back" href={getRelativeLocaleUrl(lang, '/projects')}>
        {t('project.backToProjects')}
      </a>
    </footer>
  </article>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-project-root]');
  const dialog = document.getElementById('project-lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('pbox-img') as HTMLImageElement | null;
  const cap = document.getElementById('pbox-cap');
  const closeBtn = document.getElementById('pbox-close');

  if (root && dialog && img && cap) {
    root.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-proj-lightbox-src]'
      );
      if (!trigger) return;
      img.src = trigger.dataset.projLightboxSrc ?? '';
      img.alt = trigger.dataset.projLightboxAlt ?? '';
      cap.textContent = trigger.dataset.projLightboxCaption ?? '';
      dialog.showModal();
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      img.alt = '';
    });
  }
</script>

<style>
  .project__head {
    padding-block-start: var(--space-7);
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .project__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
    letter-spacing: var(--ls-meta);
    margin-block-end: var(--space-4);
  }

  .project__title {
    max-width: var(--measure-read);
  }

  .project__summary {
    margin-block-start: var(--space-5);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .project__meta {
    margin-block-start: var(--space-6);
  }

  .project__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin-block-start: var(--space-5);
    margin-block-end: 0;
  }

  @media (min-width: 640px) {
    .project__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fact {
    margin: 0;
  }

  .fact dt {
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
  }

  .fact dd {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    color: var(--text);
  }

  .fact dd a {
    color: var(--sulfur-300);
    text-decoration: none;
    border-block-end: var(--hairline) solid var(--sulfur-400);
    word-break: break-all;
  }

  .fact dd a:hover {
    color: var(--sulfur-400);
  }

  /* ── Metrics: proof-gated figures, same visual language as StatStrip ── */
  .project__metrics-wrap {
    margin-block-start: var(--space-6);
  }

  .project__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--hairline);
    background: var(--line);
    border: var(--hairline) solid var(--line);
  }

  .metric {
    background: var(--ink-900);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    display: block;
    transition: background var(--t-fast) ease;
  }

  .metric:hover {
    background: var(--ink-800);
  }

  .metric__value {
    font-family: var(--f-code);
    font-size: var(--step-1);
    color: var(--text-hi);
    font-weight: 600;
    display: block;
  }

  .metric__label {
    display: block;
    margin-block-start: var(--space-1);
    font-size: var(--step--1);
    color: var(--text-lo);
  }

  .metric__verify {
    display: block;
    margin-block-start: var(--space-2);
    font-family: var(--f-code);
    font-size: var(--text-2xs);
    color: var(--blue-400);
  }

  .project__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block-start: var(--space-7);
    padding-block-end: var(--space-8);
  }

  .project__content,
  .project__toc {
    min-width: 0;
  }

  @media (min-width: 1080px) {
    .project__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      gap: var(--space-8);
    }

    .project__content {
      order: 1;
    }

    .project__toc {
      order: 2;
      position: sticky;
      top: calc(var(--space-5) + 56px);
    }
  }

  .project__toc {
    align-self: start;
    border-inline-start: var(--hairline) solid var(--line);
    padding-inline-start: var(--space-4);
  }

  .project__toc-label {
    margin: 0 0 var(--space-3);
  }

  .project__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project__toc-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-size: var(--step--1);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .project__toc-list a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .project__kind {
    color: var(--sulfur-400);
  }

  .project__sec-label {
    display: block;
    margin: 0 0 var(--space-4);
    color: var(--blue-400);
  }

  .project__gallery {
    padding-block-start: var(--space-6);
  }

  .pgallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--space-4);
  }

  .pfig {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pfig__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: var(--hairline) solid var(--ink-600);
    background: var(--ink-900);
    cursor: zoom-in;
    overflow: hidden;
  }

  .pfig__btn:hover {
    border-color: var(--sulfur-400);
  }

  .pfig__img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .pfig__cap {
    font-size: var(--text-xs);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .pgraph {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .pgraph__head {
    margin: 0 0 var(--space-2);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
  }

  html[lang='ar'] .pgraph__head,
  html[lang='ar'] .project__kind,
  html[lang='ar'] .pbox__close {
    font-family: var(--f-body-ar);
  }

  .pbox {
    max-width: min(92vw, var(--wrap));
    max-height: 90vh;
    padding: var(--space-4);
    background: var(--ink-900);
    color: var(--text-hi);
    border: var(--hairline) solid var(--ink-600);
  }

  .pbox::backdrop {
    background: rgba(8, 10, 15, 0.88);
  }

  .pbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-end: var(--space-3);
  }

  .pbox__cap {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .pbox__close {
    min-height: var(--touch-min);
    padding: var(--space-2) var(--space-4);
    background: var(--ink-800);
    border: var(--hairline) solid var(--ink-600);
    color: var(--text-hi);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .pbox__img {
    display: block;
    max-width: 100%;
    max-height: 75vh;
    margin-inline: auto;
    object-fit: contain;
  }

  .project__notes,
  .project__related {
    padding-block: var(--space-6);
    border-block-start: var(--hairline) solid var(--line);
  }

  .project__notes h2,
  .project__related h2 {
    font-size: var(--step-0);
    margin-block-end: var(--space-4);
  }

  .project__notes p {
    max-width: var(--measure-lead);
    color: var(--text-lo);
    line-height: var(--lh-body);
    margin: 0;
  }

  .project__related-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project__related-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .project__related-list a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
    border-block-start: var(--hairline) solid var(--line);
    font-family: var(--f-cond);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
  }

  .project__foot a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .project__foot a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .project__back {
    margin-inline-start: auto;
  }
</style>
